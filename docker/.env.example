# ==============================================
# OpensourceERP Docker-Konfiguration
# ==============================================
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
# ==============================================

# Stack-Name (fuer parallele Instanzen auf dem gleichen Server)
# Aendern wenn mehrere Stacks parallel laufen sollen (z.B. oserp-demo1, oserp-demo2)
# Beeinflusst Container-, Volume- und Netzwerk-Namen.
STACK_NAME=oserp

# Domain fuer SSL-Zertifikat (ohne https://)
DOMAIN=erp.example.com

# E-Mail fuer Let's Encrypt (Pflicht fuer Zertifikat)
CERTBOT_EMAIL=admin@example.com

# PostgreSQL (POSTGRES_USER muss 'postgres' sein wegen OWNER-Statements im Schema)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT_SETZEN
DB_AUTH_NAME=oserp_auth
DB_COMPANY_NAME=oserp_company

# PostgreSQL externer Port (fuer pgAdmin etc.)
DB_EXTERNAL_PORT=5433

# App-Einstellungen
APP_TIMEZONE=Europe/Berlin
APP_DEBUG=false

# Web-Server Ports (Standard: 80/443)
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443

# Session
SESSION_COOKIE_NAME=opensource_erp
SESSION_COOKIE_SAMESITE=Strict

# Demo-Modus (Datenbank wird nach Inaktivität automatisch zurückgesetzt)
DEMO_MODE=false
DEMO_INACTIVITY_MINUTES=20

# ----- Demo-Overlay (docker-compose.demo.yml + ./scripts/docker.sh demo-up) -----
# Absolute Pfade zu den pg_dump-Dateien auf dem Docker-Host.
# Werden beim DB-Start read-only nach /dumps/ gemountet und von den Scripts in
# docker/db/init/ automatisch in die frische (tmpfs-)DB eingespielt.
# Sowohl .sql als auch .sql.gz werden automatisch erkannt.
DEMO_AUTH_DUMP=/absoluter/pfad/zu/auth.sql
DEMO_COMPANY_DUMP=/absoluter/pfad/zu/company.sql
