{
  "name": "@oserp/portal-ui",
  "version": "0.2.0",
  "description": "Widgets des Kundenportals, des Shops und der Fahrzeuge (LxCars) als Web Components mit Shadow-DOM (Lit). Teil von OpensourceERP.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "../backend/templates-default/portal/standard/kit/assets/portal-ui/portal-widgets.js",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/check-bundle.mjs",
    "check": "node scripts/check-bundle.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "size": "esbuild src/index.js --bundle --format=esm --minify --outfile=/dev/null --analyze",
    "demo:css": "tailwindcss -c demo-src/tailwind.config.js -i demo-src/tailwind.input.css -o demo/vendor/tailwind.css --minify"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "lit": "^3.2.0",
    "tailwindcss": "^3.4.19"
  }
}
