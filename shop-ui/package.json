{
  "name": "@hugoshop/shop-ui",
  "version": "0.1.0",
  "description": "Käuferoberfläche des Shops als Web Components mit Shadow-DOM (Lit). Teil der Shop-Erweiterung von OpensourceERP.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "../backend/templates-default/shop/standard/kit/assets/shop-ui/shop-widgets.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=esm --minify --outfile=../backend/templates-default/shop/standard/kit/assets/shop-ui/shop-widgets.js",
    "build:dev": "esbuild src/index.js --bundle --format=esm --minify --sourcemap --outfile=dist/shop-widgets.js",
    "watch": "esbuild src/index.js --bundle --format=esm --sourcemap --outfile=dist/shop-widgets.js --watch",
    "size": "esbuild src/index.js --bundle --format=esm --minify --outfile=/dev/null --analyze",
    "demo:css": "tailwindcss -c demo-src/tailwind.config.js -i demo-src/tailwind.input.css -o demo/vendor/tailwind.css --minify"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "lit": "^3.2.0",
    "tailwindcss": "^3.4.19"
  }
}
