[Unit]
Description=OpensourceERP Fahrzeugschein-Eingang (überwacht die Eingangsverzeichnisse der Mandanten, inotify)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/home/work/opensource-erp
# ffi.enable=true: inotify läuft über PHP-FFI direkt auf libc (kein Zusatzpaket).
# Ohne FFI fällt der Dienst auf eine Verzeichnisabfrage im Sekundentakt zurück.
ExecStart=/usr/bin/php -d ffi.enable=true /home/work/opensource-erp/backend/cli/fahrzeugschein-eingang.php
Restart=always
RestartSec=5
TimeoutStopSec=15
User=work
Environment=HOME=/home/work
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
