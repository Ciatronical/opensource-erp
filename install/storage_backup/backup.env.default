# Backup-Umgebungsvariablen
export BORG_PASSPHRASE="XXXXXX"
export BACKUP_USER="uXXXXXX"
# Verzeichnis auf dem Backupserver
export REPOSITORY_DIR="meinRechner"

export LOG_DIR="/var/log/storage_backup"
export LOG="$LOG_DIR/backup.log"

export ALERT_EMAIL="info@domain.de"

DIRS_TO_BACKUP=(
  "/"
)


# Pfade ausschließen (Bash-Array; NICHT exportieren)
EXCLUDES=(
  "/dev"
  "/proc"
  "/sys"
  "/tmp"
  "/run"
  "/lost+found"
  "/mnt"
  "/media"
  "/var/lib/lxcfs"
  "/var/run"
  "/var/cache"
  "/var/tmp"
  "/var/log"
)


export MYSQL_USER="root"
export MYSQL_PASSWORD="MYSQLPASSWD"