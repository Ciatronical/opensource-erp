[Unit]
Description=ANPR Kennzeichenerkennung für LxCars
After=postgresql.service network.target

[Service]
Type=simple
# User anpassen: gleicher User der OpensourceERP betreibt (oder www-data)
User=work
# render-Gruppe fuer Intel iGPU (OpenVINO/OpenCL via /dev/dri/renderD128)
SupplementaryGroups=render video
Environment=HOME=/home/work
# Ohne PYTHONUNBUFFERED=1 puffert Python stdout — journald sieht dann nichts
Environment=PYTHONUNBUFFERED=1
# CPU-Threads begrenzen damit andere Prozesse nicht ausgehungert werden
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
WorkingDirectory=/home/work/opensource-erp/backend/services/plate-recognition
ExecStart=/home/work/opensource-erp/backend/services/plate-recognition/venv/bin/python anpr_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
