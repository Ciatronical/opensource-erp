[Unit]
Description=OpensourceERP Kamera-Monitor (Objekterkennung)
After=network.target go2rtc.service

[Service]
ExecStart=/home/work/opensource-erp/backend/services/camera-monitor/venv/bin/python /home/work/opensource-erp/backend/services/camera-monitor/camera_monitor.py
WorkingDirectory=/home/work/opensource-erp/backend/services/camera-monitor
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
User=work
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
